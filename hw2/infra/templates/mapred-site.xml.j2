<?xml version="1.0"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
  <property>
    <name>mapreduce.framework.name</name>
    <value>yarn</value>
  </property>
  <property>
    <name>mapreduce.application.classpath</name>
    <value>{{ mapreduce_classpath }}</value>
  </property>
  <property>
    <name>mapreduce.jobhistory.address</name>
    <value>{{ namenode_ip }}:{{ mapreduce_jobhistory_rpc_port }}</value>
  </property>
  <property>
    <name>mapreduce.jobhistory.webapp.address</name>
    <value>{{ namenode_ip }}:{{ mapreduce_jobhistory_web_port }}</value>
  </property>
  <property>
    <name>mapreduce.jobhistory.intermediate-done-dir</name>
    <value>{{ mapreduce_history_tmp_dir }}</value>
  </property>
  <property>
    <name>mapreduce.jobhistory.done-dir</name>
    <value>{{ mapreduce_history_done_dir }}</value>
  </property>
</configuration>
