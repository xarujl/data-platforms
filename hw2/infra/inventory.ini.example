# Укажите приватные IP трёх узлов; значения соответствуют hw1.
[namenode]
nn ansible_host=10.35.0.11

[workers]
nn
dn0 ansible_host=10.35.0.12
dn1 ansible_host=10.35.0.13

[hdfs_nodes:children]
namenode
workers

[hdfs_nodes:vars]
ansible_user=team
ansible_ssh_private_key_file=/home/team/.ssh/team_internal
ansible_become=true
