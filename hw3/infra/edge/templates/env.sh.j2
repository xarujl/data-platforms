export JAVA_HOME={{ hive_java_home }}
export HADOOP_HOME={{ hadoop_home }}
export HADOOP_CONF_DIR={{ hive_base }}/hadoop-conf
export HIVE_HOME={{ hive_home }}
export HIVE_CONF_DIR=$HIVE_HOME/conf
export HIVE_LOG_DIR={{ hive_base }}/logs
export HIVESERVER2_PID_DIR={{ hive_base }}
export HADOOP_LOG_DIR={{ hive_base }}/logs
export HADOOP_CLIENT_OPTS="-Djava.io.tmpdir={{ hive_base }}/tmp"
export HADOOP_HEAPSIZE_MAX=${HADOOP_HEAPSIZE_MAX:-{{ hive_client_heap_mb }}}
export PATH=$JAVA_HOME/bin:$HIVE_HOME/bin:$HADOOP_HOME/bin:$PATH
